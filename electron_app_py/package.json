{
  "name": "bible-pptx-generator",
  "version": "1.0.0",
  "description": "성경 구절 PPT 변환기",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.biblepptx.app",
    "productName": "성경 구절 PPT 변환기",
    "win": {
      "target": "dir"
    },
    "forceCodeSigning": false,
    "extraResources": [
      { "from": "../text_DB",       "to": "text_DB" },
      { "from": "../pptx_template", "to": "pptx_template" },
      { "from": "../pptx_generator","to": "pptx_generator" },
      { "from": "python",           "to": "python" }
    ]
  }
}
