{
  "name": "bible-pptx-generator",
  "version": "1.0.0",
  "description": "성경 구절 PPT 변환기",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.biblepptx.app",
    "productName": "성경 구절 PPT 변환기",
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      { "from": "../text_DB", "to": "text_DB" },
      { "from": "../pptx_template", "to": "pptx_template" }
    ]
  }
}
