@echo off
chcp 65001 > nul
title 말씀 & 예배 PPT 변환기 - 최초 설치
echo ========================================================
echo    말씀 & 예배 PPT 변환기 - 자동 설치 마법사
echo ========================================================
echo.
echo [1단계/2단계] Python 필수 라이브러리(python-pptx) 설치 중...
pip install python-pptx
if %errorlevel% neq 0 (
    echo.
    echo --------------------------------------------------------
    echo [오류] Python이 설치되어 있지 않거나 PATH 등록이 누락되었습니다.
    echo README.md 문서의 '1. 파이썬 설치' 안내를 참고해 주세요!
    echo (설치 시 'Add python.exe to PATH' 체크 필수)
    echo --------------------------------------------------------
    pause
    exit /b
)

echo.
echo [2단계/2단계] 프로그램 구동에 필요한 모듈 설치 중 (1~2분 소요)...
cd /d "%~dp0electron_app_py"
call npm install
if %errorlevel% neq 0 (
    echo.
    echo --------------------------------------------------------
    echo [오류] Node.js가 설치되어 있지 않거나 오류가 발생했습니다.
    echo README.md 문서의 '2. Node.js 설치' 안내를 참고해 주세요!
    echo --------------------------------------------------------
    pause
    exit /b
)

echo.
echo ========================================================
echo  🎉 축하합니다! 모든 설치가 성공적으로 완료되었습니다!
echo  이제 '실행하기.bat' 파일을 더블 클릭하면 프로그램이 켜집니다.
echo ========================================================
echo.
pause
